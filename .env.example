# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=adx-bank
ENV=local
FRONTEND_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# Docker Compose uses POSTGRES_PASSWORD to build DATABASE_URL automatically.
# For local dev WITHOUT Docker, uncomment and set DATABASE_URL directly.
POSTGRES_PASSWORD=your-postgres-password

# DATABASE_URL=postgresql+asyncpg://adx:<your-postgres-password>@localhost:5432/banking

# ── Redis ─────────────────────────────────────────────────────────────────────
# Docker Compose sets this automatically.
# Uncomment only if running WITHOUT Docker:
# REDIS_URL=redis://localhost:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here

# ── AI Providers ──────────────────────────────────────────────────────────────
# Priority order for fallback chain. At least one key must be set.
AI_PROVIDER_PRIORITY=groq,openai,claude

GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── Email / SMTP (for OTP delivery) ──────────────────────────────────────────
# Gmail: create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@adxbank.com
SMTP_FROM_NAME=ADX Bank
